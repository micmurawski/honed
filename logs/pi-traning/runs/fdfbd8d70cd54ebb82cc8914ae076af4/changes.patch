-    if route.include_in_schema:
+    if _route_should_be_included(route):
         dependency_data = _get_openapi_dependency_data(route.dependant)
         all_route_params = [
             field
@@ -548,6 +548,15 @@ def _get_api_route_for_openapi(
     return None
 
 
+def _route_should_be_included(route: routing._APIRouteLike) -> bool:
+    if not route.include_in_schema:
+        return False
+    predicate = route.include_in_schema_if
+    if predicate is None:
+        return True
+    return bool(predicate())
+
+
 def get_fields_from_routes(
     routes: Sequence[BaseRoute | routing.RouteContext],
 ) -> list[ModelField]:
@@ -559,7 +568,7 @@ def get_fields_from_routes(
