+def _apply_default_response_headers(
+    response: Response, default_response_headers: dict[str, str] | None
+) -> None:
+    """Inject per-route default response headers into ``response``.
+
+    Existing header values on the response (whether set by the response class
+    or explicitly by the route handler) take precedence; defaults are only
+    added for keys that are not already present (case-insensitive match).
+    """
+    if not default_response_headers:
+        return
+    existing_keys = {name.decode("latin-1").lower() for name, _ in response.headers.raw}
+    for name, value in default_response_headers.items():
+        if name.lower() in existing_keys:
+            continue
+        response.headers.raw.append((name.lower().encode("latin-1"), str(value).encode("latin-1")))
+
