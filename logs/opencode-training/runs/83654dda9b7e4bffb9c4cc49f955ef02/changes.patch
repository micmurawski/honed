diff --git a/fastapi/openapi/utils.py b/fastapi/openapi/utils.py
index 74caac44a..131a27443 100644
--- a/fastapi/openapi/utils.py
+++ b/fastapi/openapi/utils.py
@@ -308,6 +308,23 @@ def get_openapi_operation_metadata(
     return operation
 
 
+def _resolve_include_in_schema(
+    route: routing._APIRouteLike,
+) -> bool:
+    """
+    Decide whether a route should appear in the generated OpenAPI schema.
+
+    If the route was registered with ``include_in_schema_if``, that callable is
+    evaluated at schema generation time and its return value takes precedence
+    over ``include_in_schema``. Otherwise, the boolean ``include_in_schema``
+    is used directly, preserving the previous behavior.
+    """
+    include_in_schema_if = getattr(route, "include_in_schema_if", None)
+    if include_in_schema_if is not None:
+        return bool(include_in_schema_if())
+    return route.include_in_schema
+
+
 def get_openapi_path(
     *,
     route: routing._APIRouteLike,
@@ -328,7 +345,7 @@ def get_openapi_path(
         current_response_class = route.response_class
     assert current_response_class, "A response class is needed to generate OpenAPI"
     route_response_media_type: str | None = current_response_class.media_type
-    if route.include_in_schema:
+    if _resolve_include_in_schema(route):
         dependency_data = _get_openapi_dependency_data(route.dependant)
         all_route_params = [
             field
@@ -559,7 +576,7 @@ def get_fields_from_routes(
         api_route = _get_api_route_for_openapi(route_context)
         if api_route is None:
             continue
-        if api_route.include_in_schema:
+        if _resolve_include_in_schema(api_route):
             if api_route.body_field:
                 assert isinstance(api_route.body_field, ModelField), (
                     "A request body must be a Pydantic Field"
