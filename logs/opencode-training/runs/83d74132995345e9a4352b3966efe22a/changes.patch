+def _route_should_be_included_in_schema(route: routing._APIRouteLike) -> bool:
+    """
+    Determine if a route should be included in the generated OpenAPI schema.
+
+    If the route has ``include_in_schema_if`` set, it overrides the
+    ``include_in_schema`` flag and is evaluated each time the schema is
+    generated. Otherwise the ``include_in_schema`` boolean is used.
+    """
+    include_in_schema_if = getattr(route, "include_in_schema_if", None)
+    if include_in_schema_if is not None:
+        return bool(include_in_schema_if())
+    return route.include_in_schema
+
