diff --git a/fastapi/openapi/utils.py b/fastapi/openapi/utils.py
index 74caac44a..2173dc76a 100644
--- a/fastapi/openapi/utils.py
+++ b/fastapi/openapi/utils.py
@@ -305,6 +305,11 @@ def get_openapi_operation_metadata(
     operation["operationId"] = operation_id
     if route.deprecated:
         operation["deprecated"] = route.deprecated
+    if route.deprecated_at:
+        # Document when the endpoint was deprecated via the
+        # `x-deprecated-at` OpenAPI extension. The `deprecated` flag above is
+        # already set automatically when `deprecated_at` is provided.
+        operation["x-deprecated-at"] = route.deprecated_at
     return operation
 
 
